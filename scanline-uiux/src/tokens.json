      "footnote": { "$type": "number", "$value": 13, "$description": "分段/脚注 / 400" },
      "caption": { "$type": "number", "$value": 12, "$description": "注释/提示 / 400" },
      "micro": { "$type": "number", "$value": 10.5, "$description": "工具栏组标签 / 400" },
      "tab-label": { "$type": "number", "$value": 11, "$description": "Tab Bar 文字 / 600" }
