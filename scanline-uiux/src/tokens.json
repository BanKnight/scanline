    "stack": { "$type": "string", "$value": "-apple-system,'SF Pro Text','Segoe UI','PingFang SC','Microsoft YaHei',sans-serif", "$description": "UI 字体栈" },
    "web-stack": { "$type": "string", "$value": "system-ui,-apple-system,'SF Pro Text','PingFang SC',Roboto,'Noto Sans SC','Microsoft YaHei',sans-serif", "$description": "Web/手机浏览器栈" },
