      "c-primary-pressed": { "$type": "color", "$value": "#409CFF", "$light": "#0A66FF", "$description": "选中强调文字" },
      "c-brand": { "$type": "color", "$value": "#5AF78E", "$light": "#17A24A", "$description": "品牌磷光绿:光标/prompt/品牌点缀;CRT 皮肤层可重映射" },
      "c-tint": { "$type": "color", "$value": "rgba(10,132,255,0.16)", "$light": "rgba(0,122,255,0.12)", "$description": "主色弱底(由 c-primary 16% 派生,color-mix 实现)" },
      "c-brand-tint": { "$type": "color", "$value": "rgba(90,247,142,0.13)", "$light": "rgba(23,162,74,0.10)", "$description": "品牌弱底(AI 卡/引导横幅)" }
