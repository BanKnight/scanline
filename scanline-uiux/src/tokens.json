    "platform-stacks": {
      "$type": "string",
      "$description": "多端回退:Apple→SF Pro/苹方;Android→Roboto/思源黑体;Windows→Segoe UI/雅黑;不捆绑字体、不加载 CJK webfont",
      "$value": "按平台 system-ui 回退"
    },
    "line-height-ui": { "$type": "number", "$value": 1.4, "$description": "UI 行高" },
